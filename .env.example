# ─────────────────────────────────────────────────────────────
# Public build-time settings (exposed to the browser — no secrets)
# ─────────────────────────────────────────────────────────────

# "staging" adds noindex + a staging ribbon and keeps the "previous site" link.
# Set to "production" only on the mw-foundation.org deployment.
VITE_SITE_ENV=staging

# Domain this build is served from (canonical links, social preview images, QR code).
# Leave unset for production on mw-foundation.org; set for staging, e.g.:
# VITE_SITE_URL=https://mw-foundation.ziratech.com

# Analytics (optional). Plausible is cookie-free and recommended.
# VITE_PLAUSIBLE_DOMAIN=mw-foundation.org
# GA4 loads only after the visitor accepts the cookie notice.
# VITE_GA4_ID=G-XXXXXXXXXX

# ─────────────────────────────────────────────────────────────
# Server-only secrets (Vercel → Project → Settings → Environment Variables)
# Used by api/forms.ts. Never prefix these with VITE_.
# ─────────────────────────────────────────────────────────────

# Supabase project URL and service-role key (Project settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (https://resend.com) for notification + auto-reply emails.
# MAIL_FROM must be on a domain verified in Resend (SPF + DKIM).
RESEND_API_KEY=
MAIL_FROM="Mercy Wanjau Foundation <hello@mw-foundation.org>"
MAIL_TO=info@mw-foundation.org

# Random string used to hash IP addresses for rate limiting (no raw IPs are stored)
RATE_LIMIT_SALT=
